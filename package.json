            "optional": true
        },
        "react-test-renderer": {
            "optional": true
        }
    },
    "devDependencies": {
        "@testing-library/react": "^14.0.0",
        "@testing-library/user-event": "^14.0.0",
        "jsdom": "^24.0.0",
        "react": "^18.0.0",
        "react-dom": "^18.0.0",
        "react-test-renderer": "^18.3.1"
